# Algorand Testnet (free, no API key needed)
ALGOD_URL=https://testnet-api.algonode.cloud
ALGOD_TOKEN=
INDEXER_URL=https://testnet-idx.algonode.cloud
INDEXER_TOKEN=

# Seller wallet — create at https://bank.testnet.algorand.network/
# Fund with free testnet ALGO from https://testnet.algoexplorer.io/dispenser
SELLER_ADDRESS=YOUR_TESTNET_WALLET_ADDRESS_HERE
SELLER_MNEMONIC=word1 word2 word3 ... word25

# CORS — frontend URL
FRONTEND_URL=http://localhost:5173

# ─── LLM summarizer (OPTIONAL) ───────────────────────────────────────────────
# The summarizer agent uses a REAL LLM when a key is set, else falls back to
# curated offline summaries. The demo works fully without any key.
#
# LLM_PROVIDER: "openai" | "gemini" | "auto" (default: auto — first key wins)
LLM_PROVIDER=auto
# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Google Gemini (https://aistudio.google.com/app/apikey) — GOOGLE_API_KEY also accepted
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
