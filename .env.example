# AgentHub environment template
#
# Copy this file to `.env` in the repository root for local development.
# Render/Vercel users should enter the same values in the provider dashboard.
# Never commit a real mnemonic, private key, or API key.
# Run Vite and Uvicorn from the repository root so both processes discover the
# same local `.env`; Vite exposes only variables prefixed with VITE_.

# -----------------------------------------------------------------------------
# Frontend → backend connection
# -----------------------------------------------------------------------------

# FastAPI base URL used by Vite in the browser.
# Local: http://localhost:8000
# Production: the public Render backend URL, for example
# https://agenthub-api.onrender.com
# Only VITE_-prefixed variables are bundled into the browser.
VITE_API_URL=http://localhost:8000

# Primary browser origin allowed by FastAPI CORS.
# Local: http://localhost:5173
# Production: your Vercel or Render frontend URL.
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Application database
# -----------------------------------------------------------------------------

# SQLModel connection string for persistent application data.
# The default creates backend/database.db. For production, use a managed
# database URL and persistent storage instead of an ephemeral service disk.
DATABASE_URL=sqlite:///./backend/database.db

# -----------------------------------------------------------------------------
# Algorand Testnet
# -----------------------------------------------------------------------------

# Algod JSON-RPC endpoint. Algonode provides a free public Testnet endpoint:
# https://algonode.io/
ALGOD_URL=https://testnet-api.algonode.cloud

# Algod provider token. Leave empty for the public Algonode endpoint; obtain a
# token from your selected node provider if its service requires authentication.
ALGOD_TOKEN=

# Algorand Indexer endpoint for transaction and account queries.
# Public Testnet endpoint: https://testnet-idx.algonode.cloud
INDEXER_URL=https://testnet-idx.algonode.cloud

# Indexer provider token. Leave empty for public Algonode access.
INDEXER_TOKEN=

# Testnet account that receives x402 service payments.
# Create an account with Pera Wallet, Defly, or the Algorand SDK, then fund it
# with Testnet ALGO from an Algorand Testnet dispenser. Testnet funds have no
# real-world value.
SELLER_ADDRESS=LRJPYUELQTWYEDWVHZD5PAR7EZ7LPLWEXOSHOCZZNJX3Z4FQY5T2QOFYNY

# 25-word mnemonic for the Testnet service wallet above.
# Required only when the backend signs a real demo transaction. Store this as
# a secret in Render or another secret manager; never expose it to Vite.
SELLER_MNEMONIC=replace_with_your_25_word_testnet_mnemonic

# -----------------------------------------------------------------------------
# Optional live LLM summarization
# -----------------------------------------------------------------------------

# Provider selection: auto, openai, or gemini.
# `auto` uses OpenAI when OPENAI_API_KEY is present, otherwise Gemini when a
# Gemini/Google key is present, otherwise the deterministic offline fallback.
LLM_PROVIDER=auto

# Optional OpenAI API key. Create one in the OpenAI developer platform.
OPENAI_API_KEY=

# OpenAI model used by the Summarizer Agent.
OPENAI_MODEL=gpt-4o-mini

# Optional Gemini API key. Create one in Google AI Studio.
GEMINI_API_KEY=

# Backward-compatible alias for GEMINI_API_KEY. Set only one of the two.
GOOGLE_API_KEY=

# Gemini model used by the Summarizer Agent.
GEMINI_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------------------
# External service base URLs used by the backend agent executors
# -----------------------------------------------------------------------------

# Live weather data source (Weather Intelligence Agent). Format=j1 returns JSON.
WTTR_BASE_URL=https://wttr.in

# Free translation API (Language Translator Agent). langpair=en|<lang_code>.
MYMEMORY_API_URL=https://api.mymemory.translated.net/get

# Image generation provider (Image Generator Agent). Raster images from prompts.
POLLINATIONS_URL=https://image.pollinations.ai/prompt

# Live crypto price API (Market Intelligence Agent).
COINGECKO_URL=https://api.coingecko.com/api/v3

# Knowledge API (Research Orchestrator Agent). Real Wikipedia page summaries.
WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php
